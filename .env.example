# Copy to .env and adjust. Everything here is for the LOCAL demo database only.
# Real environment variables (e.g. the "env" block in claude_desktop_config.json) take precedence.

# ---- Used by the MCP server (read-only role, never the admin user) ----
SALESTALK_DATABASE_URL=postgresql://salestalk_ro:salestalk_ro_password@127.0.0.1:5433/salestalk
SALESTALK_MAX_ROWS=500                 # hard cap on rows returned by run_sql
SALESTALK_DEFAULT_ROWS=100             # run_sql default when no limit is given
SALESTALK_STATEMENT_TIMEOUT_MS=5000    # every query is cancelled after this
# SALESTALK_LOG_LEVEL=INFO
# SALESTALK_TRANSPORT=stdio            # or streamable-http
# SALESTALK_HTTP_HOST=127.0.0.1
# SALESTALK_HTTP_PORT=8765
# SALESTALK_ALLOWED_HOSTS=             # extra Host headers allowed when binding 0.0.0.0

# ---- Used by docker compose ----
SALESTALK_DB_PORT=5433
SALESTALK_TZ=Asia/Dubai
POSTGRES_ADMIN_USER=salestalk_admin
POSTGRES_ADMIN_PASSWORD=change_me_admin
SALESTALK_RO_USER=salestalk_ro
SALESTALK_RO_PASSWORD=salestalk_ro_password
